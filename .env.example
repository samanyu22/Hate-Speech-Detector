# Environment Configuration
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# Storage Paths
DATABASE_URL=sqlite:///./data/hate_speech_detector.db
DATA_DIR=./data
MODELS_DIR=./models
CONFIG_DIR=./config

# Compute Settings
DEVICE=cpu # 'cpu', 'cuda', or 'auto'
TORCH_THREADS=4

# Logging
LOG_LEVEL=INFO

